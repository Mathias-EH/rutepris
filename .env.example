# Kopier til .env. Alt er valgfritt.

# Port for nettsiden
PORT=3000

# API-nøkkel til Statens vegvesens kjøretøyregister. Når den er satt, må brukeren oppgi
# registreringsnummer, og forbruket hentes fra bilens typegodkjenning. Gratis, bestilles med BankID her:
# https://www.vegvesen.no/dinside/data-og-api-er/tilgang-til-api-for-kjoretoyopplysninger/
# Lim inn selve nøkkelen (uten «Apikey » foran) og fjern # på linja under.
# SVV_API_KEY=

# Hvor gamle prisene kan bli før serveren oppdaterer dem selv i bakgrunnen (dager, 0 = aldri)
# AUTO_OPPDATER_DAGER=7

# OpenRouteService-nøkkel (https://openrouteservice.org). Når den er satt brukes ORS i stedet for Valhalla.
# ORS_API_KEY=

# Tving rutetjeneste: valhalla eller ors
# RUTETJENESTE=valhalla

# Egen Valhalla-server, og grensene den tillater per kall
# VALHALLA_URL=http://localhost:8002
# VALHALLA_MAKS_POLYGONER=20
# VALHALLA_MAKS_PUNKTER=50
